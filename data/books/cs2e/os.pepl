7E28  00              .BYTE   h#00       
             ;
             ;------- Opcode  11110
             ;The DECO instruction.
             ;Output format:  If the operand is negative, the algorithm prints
             ;a single '-' followed by the magnitude.  Otherwise it prints the
             ;magnitude without a leading '+'.  It suppresses leading zeros.
             ;
             number:  .EQUATE d#0        ;Value returned by function Get
             ;
             remain:  .EQUATE d#0        ;Remainder of number
             chOut:   .EQUATE d#2        ;Has a character been output yet?
             place:   .EQUATE d#4        ;Place value of number for division
             ;
7E29  68FFFE Opc11110:ADDSP   d#-2,i     ;Allocate storage for number
7E2C  C07F84          JSR     Get        ;Get number from memory
7E2F  0A0000          LOADA   number,s   ;A := number
7E32  68FFFC          ADDSP   d#-4,i     ;Allocate storage for locals
7E35  B80000          COMPA   d#0,i      ;If oprnd is negative then
7E38  987E42          BRGE    PrntMag    
7E3B  E0002D          CHARO   c#/-/,i    ;Print leading '-'
7E3E  38              NOTA               ;and negate oprnd
7E3F  180001          ADDA    d#1,i      
7E42  120000 PrntMag: STOREA  remain,s   ;remain := abs(oprnd)
7E45  080000          LOADA   FALSE,i    ;Initialize chOut := FALSE
7E48  120002          STOREA  chOut,s    
7E4B  082710          LOADA   d#10000,i  ;place := 10,000
7E4E  120004          STOREA  place,s    
7E51  C07E7F          JSR     Divide     ;Write 10,000's place
7E54  0803E8          LOADA   d#1000,i   ;place := 1000
7E57  120004          STOREA  place,s    
7E5A  C07E7F          JSR     Divide     ;Write 1000's place
7E5D  080064          LOADA   d#100,i    ;place := 100
7E60  120004          STOREA  place,s    
7E63  C07E7F          JSR     Divide     ;Write 100's place
7E66  08000A          LOADA   d#10,i     ;place := 10
7E69  120004          STOREA  place,s    
7E6C  C07E7F          JSR     Divide     ;Write 10's place
7E6F  0A0000          LOADA   remain,s   ;Always write 1's place
7E72  300030          ORA     h#0030,i   ;Convert decimal to ASCII
7E75  597C4B          STBYTA  byteBuff,d 
7E78  E17C4B          CHARO   byteBuff,d 
7E7B  680006          ADDSP   d#6,i      ;Deallocate storage for locals
7E7E  C8              RTS                
             ;
             ;Subroutine to print the most significant decimal digit of the
             ;remainder.  It assumes that place (place2 here) contains the
             ;decimal place value.  It updates the remainder.
             ;
             remain2: .EQUATE d#2        ;Stack addresses while executing a
             chOut2:  .EQUATE d#4        ;subroutine are greater by two because
             place2:  .EQUATE d#6        ;the ret addr is on the stack
             ;
7E7F  0A0002 Divide:  LOADA   remain2,s  ;A := remainder
7E82  0C0000          LOADX   d#0,i      ;X := 0
7E85  220006 DivLoop: SUBA    place2,s   ;Division by repeated subtraction
7E88  807E94          BRLT    WriteNum   ;If remainder is negative, then done
7E8B  1C0001          ADDX    d#1,i      ;X := X + 1
7E8E  120002          STOREA  remain2,s  ;Store new remainder
7E91  707E85          BR      DivLoop    
             ;
7E94  BC0000 WriteNum:COMPX   d#0,i      ;If X != 0 then
7E97  887EA3          BREQ    CheckOut   
7E9A  080001          LOADA   TRUE,i     ;chOut := TRUE
7E9D  120004          STOREA  chOut2,s   
7EA0  707EAA          BR      PrntDgt    ;and branch to print this digit
7EA3  0A0004 CheckOut:LOADA   chOut2,s   ;else if a previous char was output
7EA6  907EAA          BRNE    PrntDgt    ;then branch to print this zero
7EA9  C8              RTS                ;else return to calling routine
             ;
7EAA  340030 PrntDgt: ORX     h#0030,i   ;Convert decimal to ASCII
7EAD  157C4A          STOREX  wordBuff,d ;temporary for output
7EB0  E17C4B          CHARO   byteBuff,d 
7EB3  C8              RTS                ;Return to calling routine
             ;
             ;------- Opcode  11111
             ;The HEXO instruction.
             ;Output format:  Outputs one word as four hex characters.  number
             ;is defined in the DECO interrupt handler.
             ;
7EB4  68FFFE Opc11111:ADDSP   d#-2,i     ;Allocate storage for number
7EB7  C07F84          JSR     Get        ;Get number from memory
7EBA  0A0000          LOADA   number,s   ;A := number
7EBD  680002          ADDSP   d#2,i      ;Deallocate storage for number
7EC0  117C4C          STOREA  wordTemp,d ;Save oprnd
7EC3  517C4C          LDBYTA  wordTemp,d ;Put high order byte in low order A
7EC6  48              ASRA               ;Shift right four bits
7EC7  48              ASRA               
7EC8  48              ASRA               
7EC9  48              ASRA               
7ECA  C07EE4          JSR     OutputAc   ;Output first hex character
7ECD  517C4C          LDBYTA  wordTemp,d ;Put high order byte in low order A
7ED0  C07EE4          JSR     OutputAc   ;Output second hex character
7ED3  517C4D          LDBYTA  byteTemp,d ;Put low order byte in low order A
7ED6  48              ASRA               ;Shift right four bits
7ED7  48              ASRA               
7ED8  48              ASRA               
7ED9  48              ASRA               
7EDA  C07EE4          JSR     OutputAc   ;Output third hex character
7EDD  517C4D          LDBYTA  byteTemp,d ;Put low order byte in low order A
7EE0  C07EE4          JSR     OutputAc   ;Output fourth hex character
7EE3  C8              RTS                
             ;
             ;Subroutine to output in hex the least significant nybble of the
             ;accumulator.
             ;
7EE4  28000F OutputAc:ANDA    h#000F,i   ;Isolate digit value
7EE7  B80009          COMPA   d#9,i      ;If it is not in 0..9 then
7EEA  787EF6          BRLE    PrepNum    
7EED  200009          SUBA    d#9,i      ;convert number to ASCII letter
7EF0  300040          ORA     h#0040,i   ;and prefix ASCII code for letter
7EF3  707EF9          BR      WriteHex   
7EF6  300030 PrepNum: ORA     h#0030,i   ;else prefix ASCII code for number
7EF9  597C4B WriteHex:STBYTA  byteBuff,d ;For output
7EFC  E17C4B          CHARO   byteBuff,d 
7EFF  C8              RTS                
             ;
             ;======= Put/Addressing mode decoder
             ;Put is a subroutine that DECI calls at the end of its input
             ;processing.  It decodes the addressing mode of the interrupted
             ;instruction, calculates the address of the operand of the
             ;interrupted instruction and puts the value of oprnd at that
             ;location in memory.
             ;
             oprnd:   .EQUATE d#2        ;Value of formal parameter stored
             ;
             oldNZVC6:.EQUATE d#6        ;Stack addresses of the register
             oldA6:   .EQUATE d#7        ;contents while executing this
             oldX6:   .EQUATE d#9        ;routine are greater by six because
             oldB6:   .EQUATE d#11       ;two return addresses and a formal
             oldPC6:  .EQUATE d#13       ;parameter are on the stack
             oldSP6:  .EQUATE d#15       
             oldIR6:  .EQUATE d#17       
             ;
7F00  560011 Put:     LDBYTX  oldIR6,s   ;A := intrpt IR
7F03  2C0003          ANDX    h#0003,i   ;Retain only address mode bits.
7F06  44              ASLX               ;An address occupies two bytes
7F07  607F0B          LOADB   jTable2,i  
7F0A  73              BR      ,x         
7F0B  7F13   jTable2: .ADDRSS Immed2     
7F0D  7F20            .ADDRSS Direct2    
7F0F  7F32            .ADDRSS StkRel2    
7F11  7F47            .ADDRSS Indexed2   
             ;
7F13  087F58 Immed2:  LOADA   msg2,i     ;Push address of message onto stack
7F16  12FFFE          STOREA  d#-2,s     
7F19  68FFFE          ADDSP   d#-2,i     
7F1C  C07FE0          JSR     PrntMsg    ;and print
7F1F  00              STOP               ;Fatal error: program terminates
             ;
7F20  0A0002 Direct2: LOADA   oprnd,s    ;A := oprnd
7F23  62000D          LOADB   oldPC6,s   ;B := intrpt PC
7F26  0C0000          LOADX   d#0,i      ;X := 0
7F29  63              LOADB   ,x         ;B := intrpt oprndSpec
7F2A  13              STOREA  ,x         ;Store in Mem[oprndSpec]
7F2B  080000          LOADA   FALSE,i    ;isUnary := FALSE
7F2E  117C4E          STOREA  isUnary,d  
7F31  C8              RTS                
             ;
7F32  0A0002 StkRel2: LOADA   oprnd,s    ;A := oprnd
7F35  62000D          LOADB   oldPC6,s   ;B := intrpt PC
7F38  0C0000          LOADX   d#0,i      ;X := 0
7F3B  63              LOADB   ,x         ;B := intrpt oprndSpec
7F3C  0E000F          LOADX   oldSP6,s   ;X := intrpt SP
7F3F  13              STOREA  ,x         ;Store in Mem[oprndSpec + SP]
7F40  080000          LOADA   FALSE,i    ;isUnary := FALSE
7F43  117C4E          STOREA  isUnary,d  
7F46  C8              RTS                
             ;
