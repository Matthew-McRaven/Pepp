7F83  00              .BYTE   h#00       
             ;
             ;======= Get/Addressing mode decoder
             ;Get is a function called at the beginning of DECO and HEXO.  It
             ;decodes the addressing mode of the interrupted instruction,
             ;calculates the operand of the interrupted instruction and returns
             ;its value in oprnd.  The stack addresses are identical to those
             ;in the Put addressing mode decoder.
             ;
7F84  560011 Get:     LDBYTX  oldIR6,s   ;X := intrpt IR
7F87  2C0003          ANDX    h#0003,i   ;Retain only address mode bits
7F8A  44              ASLX               ;An address is two bytes
7F8B  607F8F          LOADB   jTable3,i  
7F8E  73              BR      ,x         
7F8F  7F97   jTable3: .ADDRSS Immed3     
7F91  7FA8            .ADDRSS Direct3    
7F93  7FBA            .ADDRSS StkRel3    
7F95  7FCF            .ADDRSS Indexed3   
             ;
7F97  62000D Immed3:  LOADB   oldPC6,s   ;B := intrpt PC
7F9A  0C0000          LOADX   d#0,i      ;X := 0
7F9D  0B              LOADA   ,x         ;A := intrpt oprndSpec
7F9E  120002          STOREA  oprnd,s    
7FA1  080000          LOADA   FALSE,i    ;isUnary := FALSE
7FA4  117C4E          STOREA  isUnary,d  
7FA7  C8              RTS                
             ;
7FA8  62000D Direct3: LOADB   oldPC6,s   ;B := intrpt PC
7FAB  0C0000          LOADX   d#0,i      ;X := 0
7FAE  63              LOADB   ,x         ;B := intrpt oprndSpec
7FAF  0B              LOADA   ,x         ;A := Mem[oprndSpec]
7FB0  120002          STOREA  oprnd,s    
7FB3  080000          LOADA   FALSE,i    ;isUnary := FALSE
7FB6  117C4E          STOREA  isUnary,d  
7FB9  C8              RTS                
             ;
7FBA  62000D StkRel3: LOADB   oldPC6,s   ;B := intrpt PC
7FBD  0C0000          LOADX   d#0,i      ;X := 0
7FC0  63              LOADB   ,x         ;B := intrpt oprndSpec
7FC1  0E000F          LOADX   oldSP6,s   ;X := intrpt SP
7FC4  0B              LOADA   ,x         ;A := Mem[oprndSpec + SP]
7FC5  120002          STOREA  oprnd,s    
7FC8  080000          LOADA   FALSE,i    ;isUnary := FALSE
7FCB  117C4E          STOREA  isUnary,d  
7FCE  C8              RTS                
             ;
7FCF  62000B Indexed3:LOADB   oldB6,s    ;B := intrpt B
7FD2  0E0009          LOADX   oldX6,s    ;X := intrpt X
7FD5  0B              LOADA   ,x         ;A := Mem[B + X]
7FD6  120002          STOREA  oprnd,s    
7FD9  080001          LOADA   TRUE,i     ;isUnary := TRUE
7FDC  117C4E          STOREA  isUnary,d  
7FDF  C8              RTS                
             ;
             ;======= Print subroutine
             ;Prints a line feed character followed by the string of ASCII
             ;bytes until it encounters a null byte (eight zero bits).  Assumes
             ;one parameter, which contains the address of the message.
             ;
             msgAddr: .EQUATE d#2        ;Address of message to print
             ;
7FE0  E0000A PrntMsg: CHARO   lineFeed,i 
7FE3  620002          LOADB   msgAddr,s  ;B := address of message
7FE6  0C0000          LOADX   d#0,i      ;X := 0
7FE9  080000          LOADA   d#0,i      ;A := 0
7FEC  53     PrntMore:LDBYTA  ,x         ;Test next char from Mem[B + X]
7FED  887FF7          BREQ    StopPrnt   ;If null then exit
7FF0  E3              CHARO   ,x         ;else print
7FF1  1C0001          ADDX    d#1,i      ;X := X + 1 for next character
7FF4  707FEC          BR      PrntMore   
             ;
7FF7  C8     StopPrnt:RTS                
             ;
             ;======= Vectors reserved for machine use
7FF8  7BE6            .ADDRSS osRAM      ;User stack pointer
7FFA  7C4A            .ADDRSS wordBuff   ;System stack pointer
7FFC  7C50            .ADDRSS Loader     ;Loader program counter
7FFE  7C95            .ADDRSS Intrupt    ;Interrupt program counter
             ;
8000                  .END               
