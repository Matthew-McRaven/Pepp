-------------------------------------------------------------------------------
      Object
Addr  code   Symbol   Mnemon  Operand    Comment
-------------------------------------------------------------------------------
             ;
             ;******* Pep/7 Operating System, 5/2/00
             ;
             lineFeed:.EQUATE h#000A     ;ASCII line feed character
             space:   .EQUATE h#0020     ;ASCII space character
             TRUE:    .EQUATE d#1        
             FALSE:   .EQUATE d#0        
             ;
             ;******* Operating system RAM
7BE6         osRAM:   .BLOCK  d#100      ;System stack area
7C4A         wordBuff:.BLOCK  d#1        ;Input/output buffer
7C4B         byteBuff:.BLOCK  d#1        ;Least significant byte of wordBuff
7C4C         wordTemp:.BLOCK  d#1        ;Temporary word storage
7C4D         byteTemp:.BLOCK  d#1        ;Least significant byte of tempWord
7C4E         isUnary: .BLOCK  d#2        ;Boolean flag
             ;
             ;******* Operating system ROM
7C50                  .BURN   h#7FFF     ;Version OS/7.0
             ;
             ;======= System loader
             ;Loader format rules
             ;This loader assumes that all data in the object file to be
             ;loaded is in the following strict format:  Each hex number
             ;representing a byte must contain exactly two characters, each
             ;character must be in 0..9, A..F, or a..f and must be followed
             ;by exactly one space.  No leading spaces are permitted at the
             ;beginning of a line.  No trailing spaces are permitted at the
             ;end of a line.  The last two characters in the file must be
             ;lowercase zz, which is used as a terminating sentinel.  To
             ;improve execution speed, this loader does not trap input
             ;errors, and will not function properly unless the file input
             ;format is consistent with these restrictions.
             ;
7C50  600000 Loader:  LOADB   d#0,i      ;Clear base for memory store
7C53  0C0000          LOADX   d#0,i      ;Initialize index register
7C56  157C4A          STOREX  wordBuff,d ;Clear input buffer word
             ;
7C59  D97C4B GetChar: CHARI   byteBuff,d ;Get first hex digit
7C5C  097C4A          LOADA   wordBuff,d ;Put ASCII in low byte of A
7C5F  B8007A          COMPA   c#/z/,i    ;If end of file sentinel, 'z',
7C62  887C94          BREQ    StopLoad   ;then exit loader routine
7C65  B80039          COMPA   c#/9/,i    ;If ASCII <= '9', then assume decimal
7C68  787C6E          BRLE    Shift      ;and right nybble is correct number
7C6B  180009          ADDA    d#9,i      ;else convert nybble to correct number
7C6E  40     Shift:   ASLA               ;Shift left by four bits, sending the
7C6F  40              ASLA               ;number to the most significant
7C70  40              ASLA               ;nybble position in the byte
7C71  40              ASLA               
7C72  597C4D          STBYTA  byteTemp,d ;Save most significant nybble
7C75  D97C4B          CHARI   byteBuff,d ;Get second hex digit
7C78  097C4A          LOADA   wordBuff,d ;Put second ASCII in low byte of A
7C7B  B80039          COMPA   c#/9/,i    ;If ASCII <= '9', then assume decimal
7C7E  787C84          BRLE    Combine    ;and right nybble is correct number
7C81  180009          ADDA    d#9,i      ;else convert nybble to correct number
7C84  28000F Combine: ANDA    h#000F,i   ;Mask out the unwanted left nybble
7C87  317C4C          ORA     wordTemp,d ;Combine both hex digits in binary
7C8A  5B              STBYTA  ,x         ;Store in Mem[B + X]
7C8B  1C0001          ADDX    d#1,i      ;Increment index register
7C8E  D97C4B          CHARI   byteBuff,d ;Skip blank or <LF>
7C91  707C59          BR      GetChar    
             ;
7C94  00     StopLoad:STOP               
             ;
             ;======= Interrupt service routine
             oldPC:   .EQUATE d#7        ;Stack address of PC on interrupt
             oldIR:   .EQUATE d#11       ;Stack address of IR on interrupt
             ;
7C95  56000B Intrupt: LDBYTX  oldIR,s    ;X := intrpt IR
7C98  4C              ASRX               ;Discard addressing mode
7C99  4C              ASRX               ;Discard addressing mode
7C9A  4C              ASRX               ;Discard register specifier
7C9B  2C0003          ANDX    h#0003,i   ;Keep rightmost two bits of op-code
7C9E  240001          SUBX    d#1,i      ;Adjust X from 1..3 to 0..2
7CA1  44              ASLX               ;Times 2 since an address occupies
7CA2  607CB6          LOADB   jTable,i   ;two bytes
7CA5  C3              JSR     ,x         ;Call Opcode routine
             ;
7CA6  097C4E          LOADA   isUnary,d  ;If nonunary then
7CA9  907CB5          BRNE    Return     ;increment PC by additional two 
7CAC  0A0007          LOADA   oldPC,s    ;A := intrpt PC
7CAF  180002          ADDA    d#2,i      ;Increment PC by two
7CB2  120007          STOREA  oldPC,s    ;Restore PC for return
7CB5  D0     Return:  RTI                
             ;
7CB6  7CBC   jTable:  .ADDRSS Opc11101   
7CB8  7E29            .ADDRSS Opc11110   
7CBA  7EB4            .ADDRSS Opc11111   
             ;
             ;------- Opcode  11101
             ;The DECI instruction.
             ;Input format:  Any number of leading spaces or line feeds are
             ;allowed, followed by '+', '-' or a digit as the first character,
             ;after which digits are input until the first nondigit is
             ;encountered.  The status flags N, Z and V are set appropriately
             ;by this DECI routine.  The C status flag is not affected.
             ;
             oldNZVC: .EQUATE d#14       ;Stack address of NZVC on interrupt
             ;
             total:   .EQUATE d#10       ;Cumulative total of DECI number
             valAscii:.EQUATE d#8        ;Value(asciiCh)
             isOvfl:  .EQUATE d#6        ;Overflow boolean
             isNeg:   .EQUATE d#4        ;Negative boolean
             state:   .EQUATE d#2        ;State variable
             temp:    .EQUATE d#0        ;Temporary
             ;
             init:    .EQUATE d#0        ;Enumerated values for state
             sign:    .EQUATE d#1        
             digit:   .EQUATE d#2        
             ;
7CBC  68FFF4 Opc11101:ADDSP   d#-12,i    ;Allocate storage for locals
7CBF  080000          LOADA   FALSE,i    ;isOvfl := FALSE
7CC2  120006          STOREA  isOvfl,s   
7CC5  080000          LOADA   init,i     ;state := init
7CC8  120002          STOREA  state,s    
7CCB  080000          LOADA   d#0,i      ;wordBuff := 0 for input
7CCE  117C4A          STOREA  wordBuff,d 
7CD1  607CE8          LOADB   sTable,i   ;For switch jump table on state
             ;
7CD4  D97C4B Do:      CHARI   byteBuff,d ;Get asciiCh
7CD7  097C4A          LOADA   wordBuff,d ;Set Value(asciiCh)
7CDA  28000F          ANDA    h#000F,i   
7CDD  120008          STOREA  valAscii,s 
7CE0  097C4A          LOADA   wordBuff,d ;A contains asciiCh throughout loop
7CE3  0E0002          LOADX   state,s    ;switch (state)
7CE6  44              ASLX               ;An address occupies two bytes
7CE7  73              BR      ,x         
             ;
7CE8  7CEE   sTable:  .ADDRSS SInit      
7CEA  7D48            .ADDRSS SSign      
7CEC  7D63            .ADDRSS SDigit     
             ;
7CEE  B8002B SInit:   COMPA   c#/+/,i    ;if (asciiCh == '+')
7CF1  907D03          BRNE    IfMinus    
7CF4  0C0000          LOADX   FALSE,i    ;isNeg := FALSE
7CF7  160004          STOREX  isNeg,s    
7CFA  0C0001          LOADX   sign,i     ;state := sign
7CFD  160002          STOREX  state,s    
7D00  707CD4          BR      Do         
             ;
7D03  B8002D IfMinus: COMPA   c#/-/,i    ;else if (asciiCh == '-')
7D06  907D18          BRNE    Ifdigit    
7D09  0C0001          LOADX   TRUE,i     ;isNeg := TRUE
7D0C  160004          STOREX  isNeg,s    
7D0F  0C0001          LOADX   sign,i     ;state := sign
7D12  160002          STOREX  state,s    
7D15  707CD4          BR      Do         
             ;
7D18  B80030 Ifdigit: COMPA   c#/0/,i    ;else if (asciiCh is a digit)
7D1B  807D39          BRLT    IfWhite    
7D1E  B80039          COMPA   c#/9/,i    
7D21  A07D39          BRGT    IfWhite    
7D24  0C0000          LOADX   FALSE,i    ;isNeg := FALSE
7D27  160004          STOREX  isNeg,s    
7D2A  0E0008          LOADX   valAscii,s ;total := Value(asciiCh)
7D2D  16000A          STOREX  total,s    
7D30  0C0002          LOADX   digit,i    ;state := digit
7D33  160002          STOREX  state,s    
7D36  707CD4          BR      Do         
             ;
7D39  B80020 IfWhite: COMPA   space,i    ;else if (asciiCh is not a space
7D3C  887CD4          BREQ    Do         
7D3F  B8000A          COMPA   lineFeed,i ;or line feed)
7D42  907E01          BRNE    DeciErr    ;exit with DECI error
7D45  707CD4          BR      Do         
             ;
7D48  B80030 SSign:   COMPA   c#/0/,i    ;if asciiCh (is not a digit)
7D4B  807E01          BRLT    DeciErr    
7D4E  B80039          COMPA   c#/9/,i    
7D51  A07E01          BRGT    DeciErr    ;exit with DECI error
7D54  0E0008          LOADX   valAscii,s ;else total := Value(asciiCh)
7D57  16000A          STOREX  total,s    
7D5A  0C0002          LOADX   digit,i    ;state := digit
7D5D  160002          STOREX  state,s    
7D60  707CD4          BR      Do         
             ;
7D63  B80030 SDigit:  COMPA   c#/0/,i    ;if (asciiCh is not a digit)
7D66  807DB4          BRLT    DeciNorm   
7D69  B80039          COMPA   c#/9/,i    
7D6C  A07DB4          BRGT    DeciNorm   ;exit normally
7D6F  0C0001          LOADX   TRUE,i     ;else X := TRUE for later assignments
7D72  0A000A          LOADA   total,s    ;Multiply total by 10 as follows:
7D75  40              ASLA               ;First, times 2
7D76  A87D7C          BRV     Ovfl1      ;If overflow then
7D79  707D7F          BR      L1         
7D7C  160006 Ovfl1:   STOREX  isOvfl,s   ;isOvfl := TRUE
7D7F  120000 L1:      STOREA  temp,s     ;Save 2 * total in temp
7D82  40              ASLA               ;Now, 4 * total
7D83  A87D89          BRV     Ovfl2      ;If overflow then
7D86  707D8C          BR      L2         
7D89  160006 Ovfl2:   STOREX  isOvfl,s   ;isOvfl := TRUE
7D8C  40     L2:      ASLA               ;Now, 8 * total
7D8D  A87D93          BRV     Ovfl3      ;If overflow then
7D90  707D96          BR      L3         
7D93  160006 Ovfl3:   STOREX  isOvfl,s   ;isOvfl := TRUE
7D96  1A0000 L3:      ADDA    temp,s     ;Finally, 8 * total + 2 * total
7D99  A87D9F          BRV     Ovfl4      ;If overflow then
7D9C  707DA2          BR      L4         
7D9F  160006 Ovfl4:   STOREX  isOvfl,s   ;isOvfl := TRUE
7DA2  1A0008 L4:      ADDA    valAscii,s ;A := 10 * total + valAscii
7DA5  A87DAB          BRV     Ovfl5      ;If overflow then
7DA8  707DAE          BR      L5         
7DAB  160006 Ovfl5:   STOREX  isOvfl,s   ;isOvfl := TRUE
7DAE  12000A L5:      STOREA  total,s    ;Update total
7DB1  707CD4          BR      Do         
             ;
7DB4  0A0004 DeciNorm:LOADA   isNeg,s    ;If isNeg then
7DB7  887DD3          BREQ    SetNZ      
7DBA  0A000A          LOADA   total,s    ;If total != h#8000 then
7DBD  B88000          COMPA   h#8000,i   
7DC0  887DCD          BREQ    L6         
7DC3  38              NOTA               ;Negate total by taking two's comp
7DC4  180001          ADDA    d#1,i      
7DC7  12000A          STOREA  total,s    
7DCA  707DD3          BR      SetNZ      
7DCD  080000 L6:      LOADA   FALSE,i    ;else -32768 is a special case
7DD0  120006          STOREA  isOvfl,s   ;isOvfl := FALSE
             ;
7DD3  56000E SetNZ:   LDBYTX  oldNZVC,s  ;Set NZ according to total result:
7DD6  2C0001          ANDX    h#0001,i   ;First, initialize NZV to 000 
7DD9  0A000A          LOADA   total,s    ;If total is negative then
7DDC  987DE2          BRGE    CheckZ     
7DDF  340008          ORX     h#0008,i   ;set N to 1
7DE2  B80000 CheckZ:  COMPA   d#0,i      ;If total is not zero then
7DE5  907DEB          BRNE    SetV       
7DE8  340004          ORX     h#0004,i   ;set Z to 1
7DEB  0A0006 SetV:    LOADA   isOvfl,s   ;If not isOvfl then
7DEE  887DF4          BREQ    StoreFl    
7DF1  340002          ORX     h#0002,i   ;set V to 1
7DF4  5E000E StoreFl: STBYTX  oldNZVC,s  ;Store the NZVC flags
             ;
7DF7  68000A ExitDeci:ADDSP   d#10,i     ;Deallocate all locals except total
7DFA  C07F00          JSR     Put        ;Put total in memory
7DFD  680002          ADDSP   d#2,i      ;Deallocate total
7E00  C8              RTS                
             ;
7E01  087E0E DeciErr: LOADA   msg1,i     ;Push address of message onto stack
7E04  12FFFE          STOREA  d#-2,s     
7E07  68FFFE          ADDSP   d#-2,i     
7E0A  C07FE0          JSR     PrntMsg    ;and print
7E0D  00              STOP               ;Fatal error: program terminates
             ;
7E0E  455252 msg1:    .ASCII  /ERROR:  Invalid DECI input/ 
      4F523A 
      202049 
      6E7661 
