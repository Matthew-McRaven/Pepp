7F4D  0E0009          LOADX   oldX6,s    ;X := intrpt X
7F50  13              STOREA  ,x         ;Store in Mem[B + X]
7F51  080001          LOADA   TRUE,i     ;isUnary := TRUE
7F54  117C4E          STOREA  isUnary,d  
7F57  C8              RTS                
             ;
